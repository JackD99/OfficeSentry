# Copy to .env and edit. Lines starting with # are ignored.

# Public address of the portal (used for the admin-consent link).
OFFICESENTRY_BASE_URL=https://sentry.example.com
# For automatic HTTPS with the "https" profile: the domain name alone.
OFFICESENTRY_DOMAIN=sentry.example.com

# Times below are in this timezone (a name like Europe/London or America/New_York).
OFFICESENTRY_TIMEZONE=Europe/London
# When to collect from every tenant, as cron: minute hour day month weekday.
# "0 2 * * *" is every night at 02:00. "0 2 * * 1-5" is weeknights only.
OFFICESENTRY_COLLECT_CRON=0 2 * * *
# Skip a collection, or refresh before an emailed report, based on this age.
OFFICESENTRY_MAX_AGE_HOURS=12

# Snapshot retention. Trend numbers and findings are always kept forever;
# full snapshots are kept for the last N days plus the last N months.
OFFICESENTRY_KEEP_DAILY=30
OFFICESENTRY_KEEP_MONTHLY=12

# Optional. If unset, both are generated into /data/secrets.json (mode 0600).
# OFFICESENTRY_SECRET_KEY=
# Comma-separated Fernet keys; the first encrypts. Prepend a new key and run
# "python -m officesentry rotate-keys" to rotate.
# OFFICESENTRY_ENCRYPTION_KEYS=
# Only for local development over plain HTTP.
# OFFICESENTRY_INSECURE_COOKIES=1
