# Copy to .env and edit. Lines starting with # are ignored.

# Which release of Office Sentry to run (https://github.com/JackD99/OfficeSentry/releases).
# An exact version such as 2.0.0 is safest: change it, then run
# "docker compose pull && docker compose up -d" to update. Unset, it is 2: the
# newest 2.x release at your last "docker compose pull".
# OFFICESENTRY_VERSION=2.0.0

# Public address of the portal (used for the admin-consent link).
OFFICESENTRY_BASE_URL=https://sentry.example.com
# For automatic HTTPS with the "https" profile: the domain name alone.
OFFICESENTRY_DOMAIN=sentry.example.com

# Times below are in this timezone (a name like Europe/London or America/New_York).
OFFICESENTRY_TIMEZONE=Europe/London
# When to collect from every tenant, as cron: minute hour day month weekday.
# "0 2 * * *" is every night at 02:00. "0 2 * * 1-5" is weeknights only.
OFFICESENTRY_COLLECT_CRON=0 2 * * *
# Skip a collection, or refresh before an emailed report, based on this age.
OFFICESENTRY_MAX_AGE_HOURS=12
# How many tenants the worker collects from at once (one collector per tenant
# at a time). Raise it for many tenants; each one is a thread, not a process.
OFFICESENTRY_WORKER_CONCURRENCY=4

# Snapshot retention. Trend numbers and findings are always kept forever;
# full snapshots are kept for the last N days plus the last N months.
OFFICESENTRY_KEEP_DAILY=30
OFFICESENTRY_KEEP_MONTHLY=12

# Optional. If unset, both are generated into secrets.json (mode 0600): in Docker
# /keys/secrets.json, a volume of its own, apart from the data and its backups.
# OFFICESENTRY_SECRET_KEY=
# Comma-separated Fernet keys; the first encrypts. Prepend a new key and run
# "python -m officesentry rotate-keys" to rotate. If you use secrets.json instead,
# "python -m officesentry rotate-keys --new" replaces both keys for you.
# OFFICESENTRY_ENCRYPTION_KEYS=
# Only for local development over plain HTTP.
# OFFICESENTRY_INSECURE_COOKIES=1
# Who must use a code from an authenticator app when signing in: all (everyone,
# client accounts included), staff (admins and analysts) or off. When unset, new
# installs use "all"; installs set up before October 2026 keep "staff".
# OFFICESENTRY_REQUIRE_MFA=all
# Number of reverse proxies in front of the portal (Caddy, nginx...). Set it to 1
# when using the docker-compose setup behind a proxy, so sign-in records and the
# per-address sign-in limits use the real client IP. Leave at 0 if nothing sits
# in front; never set it higher than the number of proxies you really have.
OFFICESENTRY_TRUSTED_PROXIES=1
# Sign people out after this many minutes without activity, and after this many hours in total.
# OFFICESENTRY_SESSION_IDLE_MINUTES=120
# OFFICESENTRY_SESSION_HOURS=8
