# Used by the "https" profile in docker-compose.yml. Caddy gets and renews the
# certificate for OFFICESENTRY_DOMAIN automatically.
{$SITE_ADDRESS} {
	encode gzip
	reverse_proxy web:8000
}

# The demo site (docker compose --profile demo). Unused without it.
{$DEMO_SITE_ADDRESS} {
	encode gzip
	reverse_proxy demo-web:8000
}
