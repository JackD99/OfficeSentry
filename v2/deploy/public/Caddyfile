# The project's own server (compose.yml here): the private portal, the website and the public demo.
# Caddy gets and renews every certificate itself.
(headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

# The private portal, for the addresses in OFFICESENTRY_PORTAL_IPS only (the server's firewall lets everyone
# in, for the website and demo). Anyone else gets a plain "not found".
{$SITE_ADDRESS} {
	@outside not remote_ip {$PORTAL_ALLOWED_IPS}
	respond @outside "Not found" 404 {
		close
	}
	header -Server
	encode gzip
	# The portal sets its own security headers; neither Caddy's nor gunicorn's name reaches the browser.
	header -Server
	reverse_proxy web:8000
}

# The website: plain files, no scripts from anywhere else.
{$WEBSITE_ADDRESS} {
	import headers
	header {
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
		X-Frame-Options DENY
		Cache-Control "public, max-age=300"
	}
	@assets path /assets/* /screenshots/* /examples/*
	header @assets Cache-Control "public, max-age=86400"
	root * /srv/website
	encode zstd gzip
	file_server
	handle_errors 404 {
		root * /srv/website
		rewrite * /404.html
		file_server
	}
}

www.{$WEBSITE_ADDRESS} {
	redir https://{$WEBSITE_ADDRESS}{uri} permanent
}

# The demo. The portal sets its own security headers, so only the Server header goes: the website's set above
# would replace the portal's stricter ones, since a block that removes a header applies all of it last.
{$DEMO_SITE_ADDRESS} {
	header -Server
	encode zstd gzip
	# A PDF takes the demo seconds of its one CPU. Stock Caddy has no per-address rate limit, so PDFs share two
	# connections to the demo: more wait their turn, however many anyone asks for, and pages stay quick.
	@pdf path *.pdf
	handle @pdf {
		reverse_proxy demo:8000 {
			transport http {
				max_conns_per_host 2
			}
		}
	}
	handle {
		reverse_proxy demo:8000
	}
}
