# SPO-Audit-Toolkit — Environment Variables
# Copy this file to .env and adjust values as needed.
# None of these are required for basic operation — the portal auto-configures on first run.

# Flask environment (set to "production" for production deployments)
# FLASK_ENV=development

# Override the default portal host/port (defaults: 127.0.0.1:5000)
# PORTAL_HOST=127.0.0.1
# PORTAL_PORT=5000

# PFX password for PowerShell subprocesses (set automatically by the portal;
# only override if running scripts manually outside the portal)
# AUDIT_PFX_PASSWORD=

# PowerShell executable path (auto-detected; override if pwsh is not on PATH)
# PWSH_PATH=/usr/bin/pwsh

# Redis / Celery (optional — portal works without these using thread-based fallback)
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
